{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Crumbtrail",
  "version": "0.1.0",
  "identifier": "org.crumbtrail.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev --port 1420",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Crumbtrail",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#f7f4ed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"]
      }
    }
  }
}
